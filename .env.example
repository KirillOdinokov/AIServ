# Скопируйте в .env и заполните. .env в Git НЕ попадает.
FLUX_USER=change-me
FLUX_PASSWORD=change-me

# Почта прайсов: приём (IMAP) и автоответы отправителю (SMTP)
EMAIL_IMAP_HOST=imap.beget.com
EMAIL_IMAP_PORT=993
EMAIL_SMTP_HOST=smtp.beget.com
EMAIL_SMTP_PORT=465
EMAIL_USER=price@enix.ooo
EMAIL_PASS=change-me
EMAIL_FROM_NAME=AI ENIX Base
EMAIL_POLL_SECONDS=60

# Уведомления (необязательно; значения по умолчанию)
# SITE_CHECK_INTERVAL=300
# NOTIFY_INTERVAL_SECONDS=60
# NOTIFY_CPU_PCT=80
# NOTIFY_RAM_PCT=80
# NOTIFY_TTFB_MS=1500
# NOTIFY_SERVER_STALE_SECONDS=300

# Правка цены письмом (URL + цена). Белый список: @enix.ru и домен сайта.
# EMAIL_PRICE_EXTRA_DOMAINS=example.ru,example.com
# EMAIL_PRICE_MAX=10000000
# EMAIL_PRICE_DRY_RUN=0
